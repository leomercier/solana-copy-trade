# .env file
# Replace with the public key of the wallet you want to monitor
# SOURCE_WALLET_ADDRESS=BNnN2MqfWLvgThYBsv6v8JQaYZXYKYahC5YCy27Ct1cX
SOURCE_WALLET_ADDRESS=xxxx
# !!! IMPORTANT: Replace with the BASE58 ENCODED PRIVATE KEY of YOUR trading wallet !!!
# Get this from your wallet software (e.g., Phantom > Account Details > Export Private Key)
# Keep this extremely secure. Do not share it.
TARGET_WALLET_PRIVATE_KEY=xxxx

# Optional: Specify a Solana RPC endpoint (e.g., from QuickNode, Alchemy, Helius, or use default)
# Using a reliable custom RPC is recommended for real trading.
# RPC_URL=https://api.mainnet-beta.solana.com # Default Mainnet
RPC_URL=https://mainnet.helius-rpc.com/?api-key=6dc7870c-309c-4c75-9ca6-e19e00b0a2ea # Use Devnet for testing!

# Optional: Adjust trade proportion/logic and minimum value
# TRADE_PROPORTION=0.1 # Example: 10% (currently not used in executeCopyTrade example logic)
# MIN_TRADE_VALUE_USD=10 # Example: Minimum $10 USD value to copy (requires price fetching - not implemented yet)
